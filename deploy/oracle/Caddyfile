{
    email {$ACME_EMAIL}
}
{$SITE_DOMAIN} {
    encode zstd gzip
    root * /srv
    handle /api/* {
        reverse_proxy api:4000
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
}
