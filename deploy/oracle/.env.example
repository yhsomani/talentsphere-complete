# Create deploy/oracle/.env locally. Never commit actual credentials.
SITE_DOMAIN=staging.example.com
ACME_EMAIL=operator@example.com
# Use URL-safe characters because this value appears in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
TOKEN_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
# Verification is unavailable until a real provider/domain is configured.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=
