  subgraph "cluster_DOCBR" { label="DOCBR"; style=dashed;
    "BR-01" [label="BR-01\nOnly `ROLE_RECRUITER`/`ROLE_ADMIN` may create/edit job postings" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-02" [label="BR-02\nOnly `ROLE_USER` may submit applications; recruiters may not apply" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-03" [label="BR-03\nCandidates review own applications only; recruiters all for their companies" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-04" [label="BR-04\nOnly recruiters/admins create scorecards and notes" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-05" [label="BR-05\nUser edits own profile only; admin any" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-06" [label="BR-06\nFlags, audit, settings, user mgmt, moderation are admin-only" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-07" [label="BR-07\nBilling actions available to recruiters, not users/admins" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-08" [label="BR-08\nRoute-level RBAC matches shared route registry" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-09" [label="BR-09\nDomain-level authorization backs state-changing commands" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-10" [label="BR-10\nJob publish-readiness rule server-validated" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-11" [label="BR-11\nJob lifecycle: draft→pending_approval→approved→scheduled→published→paused→closed→archived" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-12" [label="BR-12\nRecruiters update/publish/archive only own-company jobs" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-13" [label="BR-13\nHidden jobs are client-preference; reversible" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-14" [label="BR-14\nSaved-search digest runs as service-owned/audited scheduler" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-15" [label="BR-15\nNo duplicate ACTIVE application per user per job (partial UNIQUE + 90-day cooldown post-terminal)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-16" [label="BR-16\nNo applications to closed/unavailable jobs" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-17" [label="BR-17\nApplication lifecycle server-owned append-only" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-18" [label="BR-18\nApplication drafts autosave 30s; recoverable; versions retained" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-19" [label="BR-19\nCandidate notes/scorecards recruiter-scoped; never candidate-visible" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-20" [label="BR-20\nStatus-event history append-only" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-21" [label="BR-21\nLesson completion idempotent" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-22" [label="BR-22\nLesson prerequisites gate progression" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-23" [label="BR-23\nCourse completion → certificate + XP bonus" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-24" [label="BR-24\nChallenge language allowlist; execution limits per TD-05" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-25" [label="BR-25\nXP idempotent UNIQUE(user_id, reference_type, reference_id); daily cap **200 XP/day**" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-26" [label="BR-26\nResume exports append-only; artifact soft-delete" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-27" [label="BR-27\nAnalytics metadata whitelist-only; no raw text/tokens/secrets" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-28" [label="BR-28\nAdmin status distinguishes live/inferred/degraded/not-configured" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-29" [label="BR-29\nAdmin actions: confirmation + audit + rollback" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-30" [label="BR-30\nExtension data stays in chrome.storage.local; no sync/fetch/network" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-31" [label="BR-31\nSchedulers dry-run default; idempotent delivery keys" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-32" [label="BR-32\nSubscription state webhook-owned" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-33" [label="BR-33\nAI drafts never auto-commit to records" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-34" [label="BR-34\nT&S report lifecycle pending→under_review→resolved/dismissed" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-35" [label="BR-35\nSUPERSEDED — closures cited in §19.6" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-036" [label="BR-036\nJobs require approved org + verified owner" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-037" [label="BR-037\nApplications require ≥70% profile" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-038" [label="BR-038\nCandidates may apply only to open jobs" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-039" [label="BR-039\nDuplicate applications prevented (DB + app)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-040" [label="BR-040\nRecruiters access only their org's applications" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-041" [label="BR-041\nStrict application state machine" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-042" [label="BR-042\nOffers require completed HM-scoped scorecard review" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-043" [label="BR-043\nResumes are scanned for viruses before text extraction" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-044" [label="BR-044\nExtracted resume text encrypted at rest" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-045" [label="BR-045\nRejection emails sent with configurable delay (default 24h)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-046" [label="BR-046\nCourse enrollments unique per (user, course) for active status" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-047" [label="BR-047\nModule progress strictly sequential" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-048" [label="BR-048\nCourse completion requires passing final assessment (≥70%)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-049" [label="BR-049\nChallenge submissions run in isolated sandbox" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-050" [label="BR-050\nSandbox execution has hard resource limits (30s CPU, 512MB RAM, 1GB disk)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-051" [label="BR-051\nChallenge test cases split: public + hidden" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-052" [label="BR-052\nPlagiarism detection runs asynchronously" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-053" [label="BR-053\nBadges minted only upon verified milestone completion" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-054" [label="BR-054\nReferral rewards pay out after referred candidate's first verified hire" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-055" [label="BR-055\nSubscription changes apply at period boundary (or prorated)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-056" [label="BR-056\nEntitlements derive from active subscription only" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-057" [label="BR-057\nJobs auto-close after expiry (configurable, default 60 days)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-058" [label="BR-058\nApplications auto-archive after 90 days in submitted" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-059" [label="BR-059\nModeration flags expire after 7 days if not actioned" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-060" [label="BR-060\nXP transactions unique per (user, reference_type, reference_id)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-061" [label="BR-061\nProfile completeness ≥70% gate for job applications" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-062" [label="BR-062\nVerified organizations receive accelerated job approval" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-063" [label="BR-063\nCandidates may request data export; delivered within 30 days" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-064" [label="BR-064\nRecruiters see verified signals on candidate profiles" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-065" [label="BR-065\nAI outputs below 0.7 confidence display disclaimer" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-066" [label="BR-066\nAI outputs below 0.5 confidence are suppressed" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-067" [label="BR-067\nAll admin actions are audit-logged" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-068" [label="BR-068\nAccount termination requires Platform Admin dual approval" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-069" [label="BR-069\nInterviewer inactivity auto-escalation: 7 business days → HM escalation; 14 days → auto-transition stale_withdrawn" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-070" [label="BR-070\nCandidate non-response auto-release: 5 business days → reminders; 8 days → candidate_unresponsive" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-071" [label="BR-071\nAbandoned requisition protection: >21 calendar days → review; 30 days → auto-pause + billing credit" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-072" [label="BR-072\nManaged learners access course only while org holds unexpired assigned seat" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-073" [label="BR-073\nSeat revocation triggers 7-day grace; in-progress assessments never interrupted" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-074" [label="BR-074\nSeat consumption atomic; last-seat concurrency never oversells" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-075" [label="BR-075\nRevoked seat returns to pool; learner progress and certificates retained" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-076" [label="BR-076\nGraduation transition retains all verified signals and severs FERPA-restricted records" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-077" [label="BR-077\nBulk imports require dry-run validation preview; no silent partial imports" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-078" [label="BR-078\nFaculty/Proctor hold no org-level billing, licensing, or user-management privileges" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-079" [label="BR-079\nEmployer-facing student showcases require recorded, revocable consent" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-080" [label="BR-080\nEvery org-owned record scoped by `organization_id`; cross-tenant reads prohibited" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-081" [label="BR-081\nInstitutional pricing tiers configurable per course/package; never hard-coded" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-082" [label="BR-082\nCourse-access authorization server-side: org + learner + license + enrollment + validity" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-083" [label="BR-083\nExternal media validated before publication; invalid/private/embed-blocked rejected" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-084" [label="BR-084\nProvider embedding restrictions never bypassed; protected content never downloaded" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-085" [label="BR-085\nProvider capabilities determine available playback/completion settings" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-086" [label="BR-086\nBroken external provider isolated to affected content item; course remains functional" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-087" [label="BR-087\nPlatform stores learner progress even for externally hosted playback where trackable" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-088" [label="BR-088\nUnsupported providers produce explicit errors, never silent broken embeds" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-089" [label="BR-089\nAuthors attest right to use external content before publication" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-090" [label="BR-090\nOrg provider allowlists enforced server-side" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-091" [label="BR-091\nCourse submission requires ≥5 lessons and ≥30 min total content" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-092" [label="BR-092\nCourse requires ≥1 video or text lesson (no quiz-only courses)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-093" [label="BR-093\nStructural edits to a published course require a new version" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-094" [label="BR-094\nFree-preview lessons ≤20% of course content" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-095" [label="BR-095\nRating requires ≥20% course progress and verified enrolment" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-096" [label="BR-096\nCategory assignment required before submission" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-097" [label="BR-097\nInstructor must have an approved profile before publishing" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-098" [label="BR-098\nCourse image ≥750×422, ≤4MB" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-099" [label="BR-099\nCoupon cannot reduce price below platform minimum" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-100" [label="BR-100\nRefund window 30 days from purchase (configurable), pro-rated after" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-101" [label="BR-101\nInstructor earnings = 70% of net revenue after platform commission (configurable)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-102" [label="BR-102\nCourse announcements limited to 1/day/course" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-103" [label="BR-103\nPeer review requires ≥2 completed reviews per submission" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-104" [label="BR-104\nInstructor cannot review or rate own course" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-105" [label="BR-105\nCourse version preserves existing student progress" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-106" [label="BR-106\nLearning-path courses complete in declared order when sequenced" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-107" [label="BR-107\nQuiz attempts bounded by configured max; practice quizzes unlimited" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-108" [label="BR-108\nGraded quiz contributes to course grade; passing score configurable" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-109" [label="BR-109\nFinal exam cumulative; required for course completion when configured" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-110" [label="BR-110\nProgram certificate issued only when all required path courses complete" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-111" [label="BR-111\nAssignment late submission flagged, graded per instructor policy" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-112" [label="BR-112\nAuto-grading for code assignments reuses the challenge sandbox" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-113" [label="BR-113\nQuestion-bank reuse preserves per-attempt snapshots (no retroactive edits)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-114" [label="BR-114\nCourse archive/unpublish preserves enrolled-student access per policy" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-115" [label="BR-115\nAll course purchases are idempotent and webhook-owned" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-116" [label="BR-116\nOne reaction per user per target; changeable, never additive" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-117" [label="BR-117\nOne repost per user per post" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-118" [label="BR-118\nPost edits retain an \"edited\" marker and version history" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-119" [label="BR-119\nComment authors and post authors may moderate; authors may disable comments" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-120" [label="BR-120\nMentions notify only if the recipient allows mentions" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-121" [label="BR-121\nFollows unique; blocked/muted targets cannot be followed" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-122" [label="BR-122\nPost visibility enforced server-side (public/connections/org/private)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-123" [label="BR-123\nNewsletter subscriptions opt-in only; one-click unsubscribe (RFC 8058)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-124" [label="BR-124\nFeed must always offer a chronological view; ranking factors disclosed on demand" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-125" [label="BR-125\nUGC passes pre-publish abuse scan; post rate limits per actor" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-126" [label="BR-126\nSponsored content labelled as sponsored; never undisclosed in organic ranking" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-127" [label="BR-127\nMute hides content without unfollowing and without notifying the muted party" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-128" [label="BR-128\nMinors (16+) get private-by-default profiles and restricted outreach" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-129" [label="BR-129\nOutreach credit consumed on send to a non-connection; refunded on reply within 7 days" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-130" [label="BR-130\nOutreach weekly caps: 20 (Pro), 50 (Team), custom (Enterprise)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-131" [label="BR-131\nEndorsements require an existing connection" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-132" [label="BR-132\nWritten recommendations display only after recipient acceptance" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-133" [label="BR-133\nProfile-view logging honours the viewer's privacy mode" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-134" [label="BR-134\nIdentity-verification badges only via approved partners; failure never blocks core use" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-135" [label="BR-135\nSalary aggregates displayed only with ≥5 reports for a role/location cell" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-136" [label="BR-136\nAnonymous reviews hide identity from employer and public, never from Platform Admin/legal" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-137" [label="BR-137\nCompany responses are appended, never edit the original review" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-138" [label="BR-138\nInterview questions require moderation before public display" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-139" [label="BR-139\nContest submissions locked at server-authoritative end time; clock skew never extends" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-140" [label="BR-140\nCertification exam pass requires the configured score in a single attempt (retake policy configurable)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-141" [label="BR-141\nSkills taxonomy curated by Platform Admin; no user can create canonical skills" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-142" [label="BR-142\nSkill relationships are directional: `prerequisite_of`, `subskill_of`, `supersedes`" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-143" [label="BR-143\nCorrelations (`correlates_with`) are bidirectional and computed statistically" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-144" [label="BR-144\nEvery course, challenge, job, and candidate skill tag MUST reference a canonical skill" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-145" [label="BR-145\nSkill market signals update daily from aggregated data" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-146" [label="BR-146\nSkill graph traversal depth bounded (max 5 hops)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-147" [label="BR-147\nSkill relationships must be acyclic for `prerequisite_of` (validated at write time)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-148" [label="BR-148\nEmerging skills require minimum 5 independent signals before taxonomy promotion" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-149" [label="BR-149\nCredentials are append-only; revocation creates a new record with `revoked_at`" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-150" [label="BR-150\nEvery credential has a public verification URL (no PII exposed)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-151" [label="BR-151\nCredential evidence links are immutable once issued" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-152" [label="BR-152\nEndorsement weights derive from endorser's verified reputation + relationship proximity" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-153" [label="BR-153\nAnonymous endorsements are not permitted (P-01)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-154" [label="BR-154\nAppeal path exists for disputed credentials; SLA ≤7 days" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-155" [label="BR-155\nPrivacy-preserving proofs allow skill verification without revealing full profile" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-156" [label="BR-156\nCredential issue requires underlying achievement verified by platform activity" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-157" [label="BR-157\nCareer outcome tracking requires explicit user opt-in" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-158" [label="BR-158\nAggregated career data requires k ≥5 for display" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-159" [label="BR-159\nIndividual career transitions visible only to the user" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-160" [label="BR-160\nProgression benchmarks by role require ≥20 data points to publish" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-161" [label="BR-161\nSalary progression tracked separately from base salary" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-162" [label="BR-162\nCareer graph updates do not retroactively alter historical benchmarks" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-163" [label="BR-163\nCareer path recommendations must disclose data sources and confidence intervals" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-164" [label="BR-164\nReputation score is derived, never manually set" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-165" [label="BR-165\nReputation is skill-specific" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-166" [label="BR-166\nTime-decay: signals older than 24 months count less" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-167" [label="BR-167\nReputation is private by default; recruiter visibility requires candidate consent or active application" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-168" [label="BR-168\nReputation signals are auditable" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-169" [label="BR-169\nInterview recording requires dual consent" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-170" [label="BR-170\nRecordings encrypted at rest; retention ≤90 days unless extended" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-171" [label="BR-171\nAI feedback is advisory; never a hiring decision input without human review" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-172" [label="BR-172\nAI analysis excludes protected attributes" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-173" [label="BR-173\nInterview questions are company-scoped; not visible to candidates before assessment" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-174" [label="BR-174\nAssessment scores are append-only; changes are compensating entries" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-175" [label="BR-175\nLive coding environment reuses the challenge sandbox" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-176" [label="BR-176\nComparison across candidates uses structured rubrics, never free-form scores" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-177" [label="BR-177\nSalary reports require verification: self-reported (0.5) or verified via employment (1.0)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-178" [label="BR-178\nAggregated salary data requires k ≥5 submissions per cell" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-179" [label="BR-179\nSalary data displayed in minor units + ISO-4217 currency" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-180" [label="BR-180\nCompany-specific salary data shown only if company has ≥3 reports OR opted in" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-181" [label="BR-181\nUsers may withdraw their salary submission at any time" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-182" [label="BR-182\nSalary intelligence updates quarterly; historical data versioned" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-183" [label="BR-183\nEquity data (F-98) separately aggregated from salary" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-184" [label="BR-184\nRecommendation factors must be disclosed (\"why am I seeing this?\")" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-185" [label="BR-185\nRecommendations never use protected attributes" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-186" [label="BR-186\nUsers can dismiss recommendations; dismissals train the model" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-187" [label="BR-187\nRecommendations may not include promoted content without explicit \"sponsored\" label" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-188" [label="BR-188\nRecommendation engine must be replaceable without breaking downstream features" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-189" [label="BR-189\nCourse outcome correlation requires ≥30 enrolled learners with measurable outcomes" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-190" [label="BR-190\nIndividual learner outcomes are never exposed without consent" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-191" [label="BR-191\nCourse quality scores derived from outcomes visible to instructors, not publicly ranked" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-192" [label="BR-192\nLearning impact analytics do not create incentives to lower standards" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-193" [label="BR-193\nCorrelation is not causation — all outcome claims labelled as correlational" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-194" [label="BR-194\nPeer mentorship sessions have a 30-day inactivity auto-close" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-195" [label="BR-195\nExpert network calls may be paid; platform takes a transparent fee" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-196" [label="BR-196\nIndustry hubs must have ≥3 active contributors to display" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-197" [label="BR-197\nResume parsing never auto-applies changes without user review" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-198" [label="BR-198\nCustom assessments must be approved by Platform Admin before deployment" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-199" [label="BR-199\nCandidate comparison requires verified profiles only" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-200" [label="BR-200\nDE&I analytics use aggregated data only; individual demographic data never stored" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-201" [label="BR-201\nPost-hire analytics require employer consent and are aggregate-only" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-202" [label="BR-202\nBadge marketplace prohibits paid badges; all badges earned" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-203" [label="BR-203\nMobile-first application must maintain feature parity with desktop" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-204" [label="BR-204\nAccessibility is a release gate; WCAG 2.2 AA mandatory" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-205" [label="BR-205\nAPI access requires enterprise tier; rate-limited per CON-006" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-206" [label="BR-206\nEmerging skills require platform-wide adoption before taxonomy promotion" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-207" [label="BR-207\nJob market analytics require k ≥10 data points per geographic cell" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-208" [label="BR-208\nAll new AI-powered features inherit AI safety rules §32" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-209" [label="BR-209\nIntroducer consent required for each introduction" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-210" [label="BR-210\nMax path depth = 4" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-211" [label="BR-211\nMax 10 intro requests/week/user" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-212" [label="BR-212\nIntroducer can opt out of intro services" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-213" [label="BR-213\nTarget can block all intro requests" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-214" [label="BR-214\nIntroduction messages separate from cold outreach" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-215" [label="BR-215\nPaths visible only to requester" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-216" [label="BR-216\nNo path suggestion for blocked users" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-217" [label="BR-217\nMinimum reason category required on rejection" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-218" [label="BR-218\nFeedback delivered within 7 days of decision" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-219" [label="BR-219\nFeedback visible only to candidate" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-220" [label="BR-220\nAggregate insights use k ≥10" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-221" [label="BR-221\nAI drafts require human review before sending" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-222" [label="BR-222\nCandidate can request feedback if not provided (30-day window)" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-223" [label="BR-223\nNegative feedback must include actionable element" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-224" [label="BR-224\nFeedback templates org-configurable" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-225" [label="BR-225\nFreshness score computed nightly, immutable per day" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-226" [label="BR-226\nDecay curves per skill category, admin-configurable" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-227" [label="BR-227\nFreshness <20 demotes to self-reported" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-228" [label="BR-228\nRe-verification restores freshness to 100" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-229" [label="BR-229\nSelf-attestation counts 0.5×" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-230" [label="BR-230\nFreshness visible to candidate always; recruiter-visible only with consent" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-231" [label="BR-231\nMarket drift alerts opt-in" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-232" [label="BR-232\nFreshness stored historically (time-series)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-233" [label="BR-233\nMax 3 referral requests per 30 days per candidate" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-234" [label="BR-234\nReferrer consent required per request" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-235" [label="BR-235\nReferral tag visible to recruiter (priority signal)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-236" [label="BR-236\nReferral rewards follow org policy; XP default" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-237" [label="BR-237\nSystem verifies referrer's employment" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-238" [label="BR-238\nNo referral request from blocked user" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-239" [label="BR-239\nReferrer max 20 referrals/quarter" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-240" [label="BR-240\nReferral attribution tracked 12 months" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-241" [label="BR-241\nAffiliation verified (email domain or institutional seat)" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-242" [label="BR-242\nAlumni discovery respects privacy settings" fillcolor="#f3e5f5" color="#2e7d32"];
    "BR-243" [label="BR-243\nAlumni group default-join, opt-out allowed" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-244" [label="BR-244\nAlumni job postings must be from verified alumni" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-245" [label="BR-245\nAlumni mentorship opt-in" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-246" [label="BR-246\nNo cross-institution data leakage" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-247" [label="BR-247\nGraduated students retain alumni status" fillcolor="#f3e5f5" color="#9e9e9e"];
    "BR-248" [label="BR-248\nAlumni networks public or private (institution choice)" fillcolor="#f3e5f5" color="#9e9e9e"];
  }
