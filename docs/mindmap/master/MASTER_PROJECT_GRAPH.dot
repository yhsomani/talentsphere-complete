  subgraph "cluster_JOUR" { label="JOUR"; style=dashed;
    "JOUR-001" [label="JOUR-001\naccessibility: the skip link is revealed on focus and moves focus to main content" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-002" [label="JOUR-002\naccessibility: primary navigation is reachable by keyboard alone" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-003" [label="JOUR-003\naccessibility: every interactive control on the login form is operable by keyboard" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-004" [label="JOUR-004\naccessibility: focused controls render a visible focus indicator" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-005" [label="JOUR-005\naccessibility: honours the reduced-motion preference" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-006" [label="JOUR-006\naccessibility: every vacancy on the jobs page is named and actionable by keyboard" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-007" [label="JOUR-007\naccessibility: each pricing option is a labelled region whose action is keyboard reachable" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-008" [label="JOUR-008\naccount-deletion: confirm stays disabled until DELETE and a password are both entered" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-009" [label="JOUR-009\naccount-deletion: a wrong password is shown on the field, keeps the account, and is gone after reopening" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-010" [label="JOUR-010\naccount-deletion: the right password deletes the account and signs out" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-011" [label="JOUR-011\naccount-security: changing the password signs out the other device and keeps this one" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-012" [label="JOUR-012\naccount-security: signing out ends the session on the server, not only in this browser" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-013" [label="JOUR-013\naccount-security: signing out of other devices ends the other session and keeps this one" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-015" [label="JOUR-015\ncareer-readiness: a candidate with no skills is sent to add some first" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-016" [label="JOUR-016\ncareer-readiness: picks a role, must state education, and sees a score with the missing milestones" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-017" [label="JOUR-017\ncareer-readiness: a lower education level lowers the education part of the score" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-019" [label="JOUR-019\nchallenges: lists real challenges and shows only the public examples in a session" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-020" [label="JOUR-020\nchallenges: submits a solution, says it was not run or scored, and stores it as unverified" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-021" [label="JOUR-021\ncheckout-idempotency: checkout keys: reused after a network failure, new after an answered failure or a cycle ch" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-022" [label="JOUR-022\ncore-loop: a recruiter signs up, sets up a company and publishes a job" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-023" [label="JOUR-023\ncore-loop: a candidate signs up and sees a dashboard about them, not a demo" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-024" [label="JOUR-024\ncore-loop: the candidate proves a role: work email code, then a reference" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-025" [label="JOUR-025\ncore-loop: the referee vouches from the emailed link, which then stops working" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-026" [label="JOUR-026\ncore-loop: the candidate finds the job and applies with a note" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-027" [label="JOUR-027\ncore-loop: the recruiter sees how the applicant is verified and moves them forward" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-028" [label="JOUR-028\ncore-loop: the candidate sees the new status and can withdraw" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-030" [label="JOUR-030\ncredentials: a new candidate sees an empty credentials section" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-031" [label="JOUR-031\ncredentials: an earned certificate is listed with a link to its public verification" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-032" [label="JOUR-032\ncredentials: verified skill evidence is listed with a working link; unverified evidence is not" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-033" [label="JOUR-033\ncredentials: a revoked certificate is shown as not valid, with the reason" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-034" [label="JOUR-034\ncredentials: a link that matches nothing is a final answer with no retry button" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-035" [label="JOUR-035\nfrontend-fixes: FE-07: text inputs have a border that meets 3:1 contrast" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-036" [label="JOUR-036\nfrontend-fixes: FE-04: retrying after a failed publish does not create a second job" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-037" [label="JOUR-037\nfrontend-fixes: FE-06: closing a job asks first, and Cancel leaves it open" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-038" [label="JOUR-038\nfrontend-fixes: FE-11: the applicant filter is a group of toggle buttons, not fake tabs" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-039" [label="JOUR-039\nfrontend-fixes: sign-in sends one request however fast it is submitted" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-040" [label="JOUR-040\nfrontend-fixes: FE-05: an API outage is not reported as a dead reference link" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-041" [label="JOUR-041\nhostile-user: script payloads in the name never execute" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-042" [label="JOUR-042\nhostile-user: a stored script payload is shown as text on the dashboard" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-043" [label="JOUR-043\nhostile-user: a 10,000 character name and a SQL-looking email are refused without a crash" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-044" [label="JOUR-044\nhostile-user: a forged token sends the user to sign in and is discarded" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-045" [label="JOUR-045\nhostile-user: a candidate cannot reach admin data through the API or the page" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-047" [label="JOUR-047\nlearning-page: lists courses, filters by level, and enrolls" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-049" [label="JOUR-049\nlesson-player: a learner works through a course to a certificate" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-050" [label="JOUR-050\nlesson-player: a course that does not exist is a final answer with no retry button" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-051" [label="JOUR-051\nmessaging: a recruiter messages an applicant, the candidate replies, both see the conversation" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-052" [label="JOUR-052\nmutation-feedback: apply shows pending state before any response exists, then reconciles on 201" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-053" [label="JOUR-053\nmutation-feedback: employment attestation shows pending state, blocks dismissal, and survives retry" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-054" [label="JOUR-054\nmutation-feedback: apply failure rolls back to idle with a safe error message, then retry succeeds" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-055" [label="JOUR-055\nmutation-feedback: apply conflict (409) reconciles to the server record instead of a dead Apply" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-056" [label="JOUR-056\nmutation-feedback: every rejected status (403, 404, 429) surfaces its message and stays idle" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-057" [label="JOUR-057\nmutation-feedback: rapid double activation sends exactly one request" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-058" [label="JOUR-058\nmutation-feedback: a response for one job never lands on another job the user moved to" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-059" [label="JOUR-059\nmutation-feedback: a verify-email rejection is still shown after the list refetch (regression)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-060" [label="JOUR-060\nmutation-feedback: reference request shows pending feedback and confirms only from the server" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-061" [label="JOUR-061\nmutation-feedback: the pricing page asks for no card and never starts a purchase" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-062" [label="JOUR-062\nmutation-feedback: offline submission fails truthfully and succeeds after reconnect" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-063" [label="JOUR-063\nmutation-feedback: a dead session (401) mid-mutation clears state and returns to sign-in with ?return=" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-064" [label="JOUR-064\nmutation-feedback: applied state is restored from the server after a reload (hydration)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-065" [label="JOUR-065\nmutation-feedback: \"Send a new code\" is locked for a minute after a send, then unlocks" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-066" [label="JOUR-066\nnavigation: a guarded deep link resumes after sign-in via ?return=" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-067" [label="JOUR-067\nnavigation: sign-out clears the session and parks the user on /login" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-068" [label="JOUR-068\nnavigation: an unknown path renders the 404 page with working destinations" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-069" [label="JOUR-069\nnavigation: client-side navigation retitles the document and announces it" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-070" [label="JOUR-070\nnavigation: the active header destination carries aria-current=\"page\"" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-071" [label="JOUR-071\nnavigation: push navigation returns the viewport to the top" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-072" [label="JOUR-072\nnavigation: mobile menu is a dismissable disclosure with focus handoff" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-073" [label="JOUR-073\nnavigation: modal traps Tab, closes on Escape and restores focus to its opener" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-074" [label="JOUR-074\nnavigation: signed out, candidate and hiring accounts each get their own destinations" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-076" [label="JOUR-076\nnetwork-page: sends a request, shows it as sent, and withdraws it" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-077" [label="JOUR-077\nnetwork-page: finds a member by name and connects with them" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-078" [label="JOUR-078\nnetwork-page: does not offer the signed-in member as a connection of their own" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-079" [label="JOUR-079\nnotifications: a recruiter is told about a new applicant and lands on that job’s pipeline" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-080" [label="JOUR-080\nnotifications: a candidate sees their application move and marks everything read" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-081" [label="JOUR-081\nnotifications: someone with no notifications sees what will appear there" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-082" [label="JOUR-082\nperformance: client-side navigation responds within the gross-regression guard" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-083" [label="JOUR-083\nperformance: signed-in pages do not shift as they load, on a phone or a desktop" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-085" [label="JOUR-085\nportfolio-resumes: adds a portfolio project and shows it after reload (F-26)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-086" [label="JOUR-086\nportfolio-resumes: creates a resume and shows it after reload (F-13)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-087" [label="JOUR-087\nprivacy-contact: unverified privacy contacts are not represented as a staffed DPO or an SLA" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-088" [label="JOUR-088\nresponsive: the header is one row, and the menu that holds navigation fits at every width" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-089" [label="JOUR-089\nresponsive: a dialog is a bottom sheet on phones and a centred panel from 640 px" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-090" [label="JOUR-090\nrestricted-account: shows an honest notice, reduced navigation and no refused requests" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-091" [label="JOUR-091\nsession-resilience: a throttled session check explains itself and recovers with Try again" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-093" [label="JOUR-093\nsettings-page: saves a preference and keeps it after reload (F-15)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-094" [label="JOUR-094\nsettings-page: offers only controls the product acts on (C-29, K-15)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-095" [label="JOUR-095\nsettings-page: connections-only visibility saved in Settings is what the profile shows (K-15)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-096" [label="JOUR-096\nsettings-page: command search opens with Ctrl+K, filters, and navigates (F-20)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-097" [label="JOUR-097\nsettings-page: command search closes on Escape and returns focus (F-20)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-099" [label="JOUR-099\nskills-graph: adding a skill shows it with its related skills, and it cannot be added twice" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-100" [label="JOUR-100\nui-sweep: sign-in with return=${target} stays on this site" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-101" [label="JOUR-101\nweb-ui: renders landing page with accessibility skip-link and truthful PWA capability status" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-102" [label="JOUR-102\nweb-ui: guards the dashboard and displays career cockpit after real sign-in" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-103" [label="JOUR-103\nweb-ui: authenticates candidate via login page and redirects to dashboard (F-01)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-104" [label="JOUR-104\nweb-ui: pricing is truthful: free, no card, and paid plans cannot be bought (F-16)" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-105" [label="JOUR-105\nweb-ui: navigates to evidence page and validates work history attestations with anti-fraud checks" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-106" [label="JOUR-106\nweb-ui: takes a challenge in a session and is told plainly that nothing was run or scored" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-107" [label="JOUR-107\nweb-ui: browses real job postings, is asked to sign in, then applies and tracks it" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-108" [label="JOUR-108\nweb-ui: renders privacy policy and terms of service pre-launch gates" fillcolor="#cfe2ff" color="#2e7d32"];
    "JOUR-109" [label="JOUR-109\nwork-history-removal: removes a mistaken role after saying what goes with it, and keeps the rest" fillcolor="#cfe2ff" color="#2e7d32"];
  }
