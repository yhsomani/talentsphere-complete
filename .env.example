# Copy to .env and adjust. .env is gitignored — never commit real credentials.
#
# DATABASE_URL — Postgres connection for dev/CI.
#   scripts/migrate.mjs creates the database if it does not exist.
#   CI sets this in the workflow instead of using a .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentsphere

# STORAGE — persistence backend. Defaults to 'pg' outside tests.
#   pg:     the core career loop (accounts, profiles, organizations, jobs,
#           applications, evidence, work history, references) and background
#           jobs are written to Postgres and survive restarts (ADR-015). Other
#           modules still keep state in process memory; their responses carry
#           `x-talentsphere-durability: ephemeral`. Run `pnpm db:migrate` first.
#   memory: nothing is durable. Refused when NODE_ENV=production or staging.
# Run exactly ONE API process per database: the API keeps a read model in
# memory (ADR-015 single-writer constraint).
# STORAGE=pg

# TOKEN_SECRET — signs session tokens (min 32 characters). Keep commented out
# for local dev (tokens then survive only within one process); production and
# staging must set it. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOKEN_SECRET=

# RATE_LIMIT_MAX_REQUESTS / RATE_LIMIT_WINDOW_MS — global limiter, per signed-in
# account (per client address when anonymous). Default 300 per 60000 ms. Health
# checks are exempt.
# RATE_LIMIT_MAX_REQUESTS=300
# RATE_LIMIT_WINDOW_MS=60000

# AUTH_RATE_LIMIT_MAX_REQUESTS — login attempts per IP+email (and sign-ups per
# IP) per 15 minutes. Default 10.
# AUTH_RATE_LIMIT_MAX_REQUESTS=10

# TRUST_PROXY — set when the API runs behind a reverse proxy / load balancer, or
# every client looks like the proxy (one shared rate-limit bucket). "1" = one
# trusted hop; "true" = trust all X-Forwarded-For hops; or a comma-separated
# list of proxy IPs/CIDRs. Unset when the API is exposed directly.
# TRUST_PROXY=1

# BILLING_MODE
#   disabled (default): paid plans cannot be activated.
#   simulated: activates paid plans WITHOUT payment, for demos and tests only.
#              Refused when NODE_ENV=production.
#   stripe: real payments through Stripe Checkout. Requires the STRIPE_* values
#           below and an HTTPS APP_URL in deployed environments. Production
#           refuses test-mode keys (sk_test_/rk_test_).
# BILLING_MODE=disabled

# Stripe (BILLING_MODE=stripe). Server-only: never expose these to the browser.
# STRIPE_SECRET_KEY — a secret or restricted key. A restricted key needs write
#   access to Customers, Checkout Sessions, Customer Portal Sessions and
#   Subscriptions.
# STRIPE_WEBHOOK_SECRET — signing secret (whsec_...) of the endpoint
#   POST <API origin>/api/v1/billing/stripe-webhook, subscribed to:
#   checkout.session.completed, customer.subscription.created/updated/deleted,
#   invoice.paid, invoice.payment_failed.
# STRIPE_PRICE_* — one Stripe Price id per paid plan and cycle; ids must be
#   distinct. Plans without a price cannot be bought. The client never supplies
#   a price or an amount.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CANDIDATE_PRO_MONTHLY=
# STRIPE_PRICE_CANDIDATE_PRO_YEARLY=
# STRIPE_PRICE_RECRUITER_STARTER_MONTHLY=
# STRIPE_PRICE_RECRUITER_STARTER_YEARLY=
# STRIPE_PRICE_RECRUITER_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_RECRUITER_ENTERPRISE_YEARLY=

# BILLING_WEBHOOK_SECRET — HMAC key for POST /api/v1/billing/webhook
# (header `x-talentsphere-signature: t=<unix>,v1=<hex HMAC-SHA256 of "t.rawBody">`).
# Unset: the webhook refuses every call (503).
# BILLING_WEBHOOK_SECRET=

# EMAIL_PROVIDER — optional transactional email. Defaults to none; deployed
# verification and reference-invitation requests return 503 until configured.
# Resend requires a verified sender domain, HTTPS APP_URL, and an API key.
# Never commit provider credentials or use sample addresses in production.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
# APP_URL=https://your-verified-web-origin.example

# BYO_AI_KEY_ENCRYPTION_KEY — 32-byte, 64-character hex key, separate from
# TOKEN_SECRET. Required before storing BYO AI keys in PostgreSQL. Store in
# a secret manager; rotation requires a planned ciphertext migration.
# BYO_AI_KEY_ENCRYPTION_KEY=

# VITE_SUPPORT_EMAIL — web build only. A support address you actually monitor;
# unset hides the contact line rather than showing an address nobody reads.
# VITE_SUPPORT_EMAIL=

# VITE_PRIVACY_EMAIL / VITE_SECURITY_EMAIL — public browser build-time
# contact addresses. Only set AFTER proving ownership, monitored delivery and
# approval of the privacy/terms policy. Without the privacy address the draft
# explicitly reports that public release is blocked; it does not invent a DPO.
# VITE_PRIVACY_EMAIL=
# VITE_SECURITY_EMAIL=
