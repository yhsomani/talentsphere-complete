# =============================================================================
# TalentSphere — Environment Template
# =============================================================================
# Copy to .env.local and fill in environment-specific values.
# NEVER commit .env.local.
#
# Architecture:
#   Frontend: React + TypeScript + Vite
#   Backend: Node.js + Fastify + TypeScript
#   Database/Auth/Storage/Queues: Supabase + PostgreSQL
#   Payments: Stripe
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=TalentSphere
APP_VERSION=0.1.0
APP_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=json

# Frontend-safe variables MUST use VITE_.
VITE_APP_NAME=TalentSphere
VITE_APP_VERSION=0.1.0
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# CORS / Security
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# -----------------------------------------------------------------------------
# Storage Buckets
# -----------------------------------------------------------------------------
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_RESUMES=resumes
SUPABASE_BUCKET_COURSE_CONTENT=course-content
SUPABASE_BUCKET_PORTFOLIO=portfolio
SUPABASE_BUCKET_MAIN=talentsphere_bucket

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# NEVER put STRIPE_SECRET_KEY in frontend code or variables prefixed VITE_.
STRIPE_SECRET_KEY=your-stripe-test-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-test-publishable-key
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-test-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

BILLING_ENABLED=true
STRIPE_CURRENCY=INR
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# -----------------------------------------------------------------------------
# Authentication / OAuth
# -----------------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_SESSION_DURATION_SECONDS=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI Gateway / Orchestration
# -----------------------------------------------------------------------------
AI_ENABLED=true
AI_DEFAULT_EXECUTION_MODE=auto
AI_FREE_USER_PAID_INFERENCE=false
AI_CLOUD_FALLBACK_ENABLED=false
AI_REQUEST_TIMEOUT_MS=30000

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_CODE_ARENA=true
FEATURE_LMS=true
FEATURE_MESSAGING=true
FEATURE_NOTIFICATIONS=true
FEATURE_GAMIFICATION=true
FEATURE_ADMIN_PANEL=true
FEATURE_ANALYTICS=true
FEATURE_COMPANY_PROFILES=true
FEATURE_SEARCH=true
FEATURE_OAUTH=true
FEATURE_AI_MATCHING=false
FEATURE_INSTITUTIONAL_B2B=false
FEATURE_VIDEO_CALLS=false
FEATURE_LEADERBOARDS=true
FEATURE_BADGES=true
FEATURE_MENTORSHIP=false
FEATURE_CHROME_EXTENSION=false

VITE_FEATURE_CODE_ARENA=true
VITE_FEATURE_LMS=true
VITE_FEATURE_MESSAGING=true
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_GAMIFICATION=true
VITE_FEATURE_SEARCH=true
VITE_FEATURE_AI_MATCHING=false
VITE_FEATURE_INSTITUTIONAL_B2B=false
VITE_FEATURE_VIDEO_CALLS=false

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
SEARCH_ENABLED=true
SEARCH_MAX_RESULTS=50

# -----------------------------------------------------------------------------
# Code Arena / Assessments
# -----------------------------------------------------------------------------
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_TIMEOUT_MS=30000
CODE_EXECUTION_MAX_MEMORY_MB=256

# -----------------------------------------------------------------------------
# Notifications / Email / Push
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@talentsphere.com
SMTP_FROM_NAME=TalentSphere

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@talentsphere.com

# -----------------------------------------------------------------------------
# Analytics / Observability
# -----------------------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# AWS / External Storage (optional; Supabase Storage is the default)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# Realtime / Jobs
# -----------------------------------------------------------------------------
SUPABASE_REALTIME_ENABLED=true
SUPABASE_REALTIME_URL=wss://YOUR_PROJECT_REF.supabase.co/realtime/v1
QUEUE_PROCESSING_ENABLED=true

# -----------------------------------------------------------------------------
# Performance / Caching
# -----------------------------------------------------------------------------
CACHE_DURATION_SHORT=60
CACHE_DURATION_MEDIUM=300
CACHE_DURATION_LONG=3600
CACHE_DURATION_STATIC=86400

# -----------------------------------------------------------------------------
# Backup / Operations
# -----------------------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# E2E Testing
# -----------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:5173
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=replace-with-dedicated-test-password
