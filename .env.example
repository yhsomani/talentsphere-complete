# ============================================================================
# TalentSphere Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Application URLs
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase Configuration
# Required: Get these from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key - KEEP SECRET - Only for server-side operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Feature Flags (optional - defaults shown)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_AI_MATCHING=false
NEXT_PUBLIC_FEATURE_CODE_ARENA=true
NEXT_PUBLIC_FEATURE_GAMIFICATION=true
NEXT_PUBLIC_FEATURE_INSTITUTIONAL_B2B=false
NEXT_PUBLIC_FEATURE_CHROME_EXTENSION=false
NEXT_PUBLIC_FEATURE_MENTORSHIP=false

# ----------------------------------------------------------------------------
# Optional: Third-party Integrations
# ----------------------------------------------------------------------------
# Add as needed for future integrations
