# Copy to .env and adjust. .env is gitignored — never commit real credentials.
#
# DATABASE_URL — Postgres connection for dev/CI.
#   scripts/migrate.mjs creates the database if it does not exist.
#   CI sets this in the workflow instead of using a .env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentsphere

# TOKEN_SECRET — signs session tokens (min 32 characters). Keep commented out
# for local dev (tokens then survive only within one process); production must
# set it. Generate: node -e "console.log(crypto.randomUUID().repeat(2))"
# TOKEN_SECRET=
