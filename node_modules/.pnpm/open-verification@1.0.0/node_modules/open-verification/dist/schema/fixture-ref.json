{
  "$id": "https://open-verification.dev/schema/v1/fixture-ref.json",
  "$ref": "#/definitions/fixture-ref",
  "definitions": {
    "fixture-ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "object",
          "properties": {
            "surface": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "web",
                    "desktop",
                    "mobile",
                    "service",
                    "game",
                    "device"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^x-[a-z0-9-]+$"
                }
              ]
            },
            "instance": {
              "type": "string",
              "minLength": 1
            },
            "epoch": {
              "type": "integer",
              "minimum": 0
            },
            "locator": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "surface",
            "instance"
          ],
          "additionalProperties": false
        },
        "capturedAt": {
          "type": "integer"
        },
        "payload": {}
      },
      "required": [
        "id",
        "subject",
        "capturedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
