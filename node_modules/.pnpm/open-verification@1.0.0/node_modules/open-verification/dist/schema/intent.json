{
  "$id": "https://open-verification.dev/schema/v1/intent.json",
  "$ref": "#/definitions/intent",
  "definitions": {
    "intent": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "enum": [
                "user",
                "developer",
                "agent",
                "system",
                "workflow",
                "derived"
              ]
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "declaredAt": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "statement",
            "origin"
          ]
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "abandoned"
                },
                "abandonedBecause": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "abandonedBecause"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "declared"
                },
                "abandonedBecause": {
                  "not": {}
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "bound"
                },
                "abandonedBecause": {
                  "not": {}
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
