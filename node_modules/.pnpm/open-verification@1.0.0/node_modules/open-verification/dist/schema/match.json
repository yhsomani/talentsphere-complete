{
  "$id": "https://open-verification.dev/schema/v1/match.json",
  "$ref": "#/definitions/match",
  "definitions": {
    "match": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "channel": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ui",
                    "net",
                    "state",
                    "signal",
                    "log",
                    "route",
                    "storage",
                    "time",
                    "visual"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^x-[a-z0-9-]+$"
                }
              ]
            }
          },
          "required": [
            "channel"
          ]
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "valueContains": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "summary",
                "valueContains"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "valueContains": {
                  "not": {}
                }
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
