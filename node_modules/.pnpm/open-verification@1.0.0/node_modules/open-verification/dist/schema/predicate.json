{
  "$id": "https://open-verification.dev/schema/v1/predicate.json",
  "$ref": "#/definitions/predicate",
  "definitions": {
    "predicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "count"
            },
            "match": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ui",
                            "net",
                            "state",
                            "signal",
                            "log",
                            "route",
                            "storage",
                            "time",
                            "visual"
                          ]
                        },
                        {
                          "type": "string",
                          "pattern": "^x-[a-z0-9-]+$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "channel"
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "valueContains": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "summary",
                        "valueContains"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "valueContains": {
                          "not": {}
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "exactly",
                "at-least",
                "at-most"
              ]
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "match",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "present"
            },
            "match": {
              "$ref": "#/definitions/predicate/anyOf/0/properties/match"
            }
          },
          "required": [
            "kind",
            "match"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "absent"
            },
            "match": {
              "$ref": "#/definitions/predicate/anyOf/0/properties/match"
            }
          },
          "required": [
            "kind",
            "match"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "measure"
            },
            "match": {
              "$ref": "#/definitions/predicate/anyOf/0/properties/match"
            },
            "op": {
              "type": "string",
              "enum": [
                "equals",
                "at-least",
                "at-most"
              ]
            },
            "value": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "default": 0
            }
          },
          "required": [
            "kind",
            "match",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
